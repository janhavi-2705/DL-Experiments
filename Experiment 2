# ---------- Cell 4: Performance comparison ----------
import time

# Create large tensor
x = tf.random.normal([10000, 10000])

# Measure computation time on the default device (GPU if available)
start = time.time()
y = tf.matmul(x, x)
_ = y.numpy()  # forces the computation to finish before stopping the timer
end = time.time()
print(f"Computation time (default device): {end - start:.4f} seconds")

# CPU comparison
with tf.device('/CPU:0'):
    x_cpu = tf.random.normal([10000, 10000])
    start = time.time()
    y_cpu = tf.matmul(x_cpu, x_cpu)
    _ = y_cpu.numpy()
    end = time.time()
print(f"Computation time (CPU):            {end - start:.4f} seconds")
